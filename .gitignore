# ── 数据（最重要！）──────────────────────────────
# 患者数据、医院导出的原始数据，绝对不要提交到 GitHub
data/*
!data/.gitkeep

# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.ipynb_checkpoints/*

# ── 虚拟环境 ────────────────────────────────────
.venv/
venv/
env/

# ── 编辑器 / 系统 ───────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 大文件与模型产物 ────────────────────────────
*.pkl
*.joblib
*.h5
*.pt
*.ckpt

# ── 数据文件一律排除（防止误提交患者数据）────────
# 如果你确实要提交某个小的公开示例数据，用：git add -f 文件名
*.csv
*.xlsx
!requirements.txt
